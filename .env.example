# =====================================================================
# SOCIAL MEDIA NEWS SENTIMENT ANALYZER - ENVIRONMENT TEMPLATE
# =====================================================================
# Copy this file to '.env' and fill in your actual API keys.
# NEVER commit your actual '.env' file to Git or share it publicly!
# =====================================================================

# 1. YOUTUBE DATA API V3 KEY (Google Cloud Console)
YOUTUBE_API_KEY=

# 2. REDDIT API CREDENTIALS (Optional - supports Zero-Auth Public Reddit JSON mode)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NewsSentimentAnalyzer/1.0 by SeniorMLEngineer

# 3. APPLICATION SETTINGS
APP_ENV=development
DATABASE_URL=sqlite:///./sentiment_analyzer.db
DEFAULT_COMMENT_LIMIT=100
SEMANTIC_SIMILARITY_THRESHOLD=0.25
TRANSFORMER_MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
